# Modello di configurazione. I valori veri stanno in .env (non versionato).
# Aftertalk Core Configuration
# Copy this file to .env and configure your values

# Database
DATABASE_PATH=cambiami

# HTTP Server
HTTP_PORT=cambiami
HTTP_HOST=cambiami

# WebSocket Server
WS_PORT=cambiami
WS_HOST=cambiami

# Logging
LOG_LEVEL=cambiami
LOG_FORMAT=cambiami

# JWT Configuration
JWT_SECRET=cambiami
JWT_ISSUER=cambiami
JWT_EXPIRATION=cambiami

# API Key for backend authentication
API_KEY=cambiami

# STT Provider Configuration
STT_PROVIDER=cambiami
GOOGLE_APPLICATION_CREDENTIALS=cambiami
AWS_ACCESS_KEY_ID=cambiami
AWS_SECRET_ACCESS_KEY=cambiami
AWS_REGION=cambiami
AZURE_SPEECH_KEY=cambiami
AZURE_SPEECH_REGION=cambiami

# LLM Provider Configuration
LLM_PROVIDER=cambiami
OPENAI_API_KEY=cambiami
OPENAI_MODEL=cambiami
ANTHROPIC_API_KEY=cambiami
ANTHROPIC_MODEL=cambiami
AZURE_OPENAI_KEY=cambiami
AZURE_OPENAI_ENDPOINT=cambiami
AZURE_OPENAI_DEPLOYMENT=cambiami

# Webhook Configuration
WEBHOOK_URL=cambiami
WEBHOOK_TIMEOUT=cambiami

# Processing Configuration
MAX_CONCURRENT_TRANSCRIPTIONS=cambiami
MAX_CONCURRENT_MINUTES_GENERATIONS=cambiami
TRANSCRIPTION_TIMEOUT=cambiami
MINUTES_GENERATION_TIMEOUT=cambiami

# Session Configuration
MAX_SESSION_DURATION=cambiami
MAX_PARTICIPANTS_PER_SESSION=cambiami

# Retention Configuration (days)
TRANSCRIPTION_RETENTION_DAYS=cambiami
MINUTES_RETENTION_DAYS=cambiami
WEBHOOK_EVENTS_RETENTION_DAYS=cambiami

# Performance
ENABLE_PROFILING=cambiami
PROFILING_PORT=cambiami
